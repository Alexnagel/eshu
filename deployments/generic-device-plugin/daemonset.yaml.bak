# Advertises host devices as allocatable Kubernetes resources so pods can
# use them WITHOUT running privileged. Here: the Nabu Casa ZBT-2 Zigbee
# coordinator (`devic.es/zigbee`) and the FTDI P1 smart-meter cable
# (`devic.es/p1`), both requested by Home Assistant.
# (devic.es is the plugin's default resource domain.)
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: generic-device-plugin
  namespace: kube-system
  labels:
    app.kubernetes.io/name: generic-device-plugin
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: generic-device-plugin
  updateStrategy:
    type: RollingUpdate
  template:
    metadata:
      labels:
        app.kubernetes.io/name: generic-device-plugin
    spec:
      priorityClassName: system-node-critical
      tolerations:
        - operator: "Exists"
          effect: "NoExecute"
        - operator: "Exists"
          effect: "NoSchedule"
      containers:
        - name: generic-device-plugin
          # renovate: datasource=docker depName=squat/generic-device-plugin
          image: docker.io/squat/generic-device-plugin:latest@sha256:8dc84958301f054bf72d9753a7a2c9af3d6642a9844b34d1171b3f2cdb4a15f6
          args:
            - --device
            - |
              name: zigbee
              groups:
                - paths:
                    - path: /dev/serial/by-id/usb-Nabu_Casa_ZBT-2_A4CB8FD2C054-if00
                      mountPath: /dev/zigbee
            # Sonoff Zigbee 3.0 Dongle Plus V2 — migration target for ZHA
            # (see deployments/homeassistant/values.yaml).
            - |
              name: zigbee-sonoff
              groups:
                - paths:
                    - path: /dev/serial/by-id/usb-Itead_Sonoff_Zigbee_3.0_USB_Dongle_Plus_V2_0ad3297809f4ef11bb6aba1b6d9880ab-if00-port0
                      mountPath: /dev/zigbee-sonoff
            - |
              name: p1
              groups:
                - paths:
                    - path: /dev/serial/by-id/usb-FTDI_FT232R_USB_UART_AWBTK7BV-if00-port0
                      mountPath: /dev/p1
          resources:
            requests:
              cpu: 50m
              memory: 10Mi
            limits:
              cpu: 50m
              memory: 20Mi
          ports:
            - containerPort: 8080
              name: http
          securityContext:
            privileged: true
          volumeMounts:
            - name: device-plugin
              mountPath: /var/lib/kubelet/device-plugins
            - name: dev
              mountPath: /dev
      volumes:
        - name: device-plugin
          hostPath:
            path: /var/lib/kubelet/device-plugins
        - name: dev
          hostPath:
            path: /dev
