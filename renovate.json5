{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    // Pin all GitHub Actions to commit SHA digests (with version comment)
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Amsterdam",
  "schedule": ["every weekend"],
  // Homelab: don't throttle our own update PRs. 0 = unlimited/hour (fixes
  // the "rate-limited" dashboard section); keep a generous concurrent cap
  // so a big backlog doesn't open a wall of PRs all at once.
  "prConcurrentLimit": 10,
  "prHourlyLimit": 0,
  "commitMessagePrefix": "⬆️",
  "semanticCommits": "enabled",
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "argocd": {"managerFilePatterns": ["/applications/.+\\.yaml$/"]},
  "kubernetes": {"managerFilePatterns": ["/deployments/.+\\.yaml$/"]},
  "helm-values": {"managerFilePatterns": ["/deployments/.+/values\\.yaml$/"]},
  "github-actions": {
    "managerFilePatterns": ["/\\.github/workflows/.+\\.ya?ml$/"]
  },
  // Tracks tool versions annotated with `# renovate: datasource=... depName=...`
  // comments in workflows (kubeconform, argocd-diff-preview)
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+?)(?: extractVersion=(?<extractVersion>[^\\s]+))?\\n\\s*[A-Za-z0-9_-]+:\\s*'?(?<currentValue>[^'\\s]+)'?"
      ]
    }
  ],
  "packageRules": [
    {"matchDatasources": ["helm"], "groupName": "Helm charts"},
    {"matchUpdateTypes": ["major"], "automerge": false},
    // Postgres majors are NOT drop-in: the server refuses to start on a data
    // directory created by a different major version. Upgrading requires a
    // dump/restore of the data first, so never propose it as a routine bump.
    // (A merged 14→16 PR took Immich down for 4 days.)
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/^ghcr\\.io/immich-app/postgres$/"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    // LinuxServer images are referenced at ghcr.io (not the lscr.io redirect,
    // which Renovate can't list tags on). Their tags are `X.Y.Z[.build]-lsNNN`,
    // so give Renovate a versioning scheme that sorts the -lsNNN suffix.
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/^ghcr\\.io/linuxserver//"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(\\.(?<build>\\d+))?-ls(?<revision>\\d+)$"
    }
  ]
}
